# Express Server Environment Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Application JWT (use a long, random value in production)
JWT_SECRET=replace-with-a-long-random-secret

# Optional first administrator bootstrap account
FIRST_ADMIN_EMAIL=admin@example.edu
# Keep false after provisioning the first administrator.
ENABLE_FIRST_ADMIN_BOOTSTRAP=false
# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
